        <mxCell id="titulo" value="C1 — Contexto (AS-IS): gestión manual de la logística de la encuesta de autosatisfacción&#10;Universidad de La Sabana · Vicerrectoría de Desarrollo · estado actual, octubre 2026" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1080" height="45" as="geometry" />
        </mxCell>

        <mxCell id="coord" value="Coordinadora de la encuesta&#10;(Vicerrectoría de Desarrollo)&#10;[Persona]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pat" value="Estudiante PAT&#10;[Persona]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=12;" vertex="1" parent="1">

<mxfile host="app.diagrams.net">
  <diagram name="Diagrama de contexto - Encuestas Unisabana" id="ctx-unisabana">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sis" value="Sistema de programación y ejecución&#10;de encuestas a estudiantes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="est" value="Estudiante" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="coord" value="Coordinador de encuestas" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="hor" value="Sistema de horarios académicos" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="380" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="bd" value="Base de datos de personas/estudiantes" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="notif" value="Notificador" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="prof" value="Profesor" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="130" height="80" as="geometry"/></mxCell>
        <mxCell id="e0" value="Responde encuesta" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="est" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="Enlace para realizar encuesta" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sis" target="est"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Define fecha, hora, capacidad, criterios" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="coord" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Resultados y reportes" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sis" target="coord"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Consulta salones disponibles" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sis" target="hor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Salones disponibles" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="hor" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Consulta estudiantes disponibles" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sis" target="bd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Estudiantes disponibles" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bd" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Notificación (1 semana antes)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sis" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Notificación al profesor" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="notif" target="prof"><mxGeometry relative="1" as="geometry"/></mxCell>
